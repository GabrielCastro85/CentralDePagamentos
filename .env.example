# =============================================================================
# Central de Pagamentos — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NUNCA deve ser commitado no Git.
# Em produção, coloque o .env em: %APPDATA%\central-de-pagamentos\.env
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Sincronização online (opcional)
# Obtenha em: painel Supabase → Settings → API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Auto Update — GitHub Releases
# Apenas necessário se o owner/repo em package.json não estiverem configurados.
# O electron-updater usa o publish.owner/repo do package.json por padrão.
# -----------------------------------------------------------------------------
# UPDATE_FEED_URL=https://github.com/SEU_USUARIO/central-de-pagamentos/releases/latest/download/latest.yml

# -----------------------------------------------------------------------------
# Publicação (apenas em CI/CD — NUNCA commitar com valor real)
# Token do GitHub com escopo: repo (para publicar releases)
# Gerar em: github.com → Settings → Developer settings → Personal access tokens
# -----------------------------------------------------------------------------
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
